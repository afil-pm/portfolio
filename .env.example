# Environment variables for AFIL PM Portfolio
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AFIL PM Portfolio"
NODE_ENV=development

# Database (PostgreSQL)
# Example: postgresql://user:password@localhost:5432/portfolio?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

# Authentication / Session
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
AUTH_SESSION_MAX_AGE=604800 # 7 days in seconds

# CSRF
# Generate with: openssl rand -base64 32
CSRF_SECRET="your-csrf-secret-here"

# Email (Nodemailer) - used for contact form notifications
# Example using Ethereal (test) or SMTP. Do NOT hardcode real credentials here.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"
CONTACT_EMAIL="hello@example.com"

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
CONTACT_RATE_LIMIT_MAX_REQUESTS=5

# Admin setup (create first admin via seed or /api/auth/register)
ADMIN_EMAIL="afilpm@admin.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="{ Afil@773688 }"
